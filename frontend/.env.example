# ==============================================================================
# Career Path Simulator - Frontend Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Base URL
# ------------------------------------------------------------------------------
# Type: string (HTTP/HTTPS URL)
# Development Default: "" (Empty string enables Vite local reverse-proxy to http://localhost:8000)
# Production Deployment (Vercel, Cloudflare Pages, Netlify):
# Set to your deployed FastAPI backend URL, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com
# Or leave empty if using Vercel rewrites (/api -> backend)
VITE_API_BASE_URL=
