# ==============================================================================
# Career Path Simulator - Backend Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Type: string ("development" | "staging" | "production")
# Default: development
ENVIRONMENT=development

# Type: integer
# Default: 8000
PORT=8000

# Type: string (IP address or hostname to bind)
# Default: 0.0.0.0
HOST=0.0.0.0

# Type: JSON array of strings or comma-separated URLs
# Default: ["http://localhost:5173", "http://127.0.0.1:5173"]
# In production, set to your Vercel frontend domain(s)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-app.vercel.app"]

# ------------------------------------------------------------------------------
# 2. Database Connectivity
# ------------------------------------------------------------------------------
# Type: string (SQLAlchemy connection URI)
# Local SQLite default: sqlite:///./dev.db
# Production PostgreSQL (Neon, Supabase, AWS RDS, Render):
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Cryptography
# ------------------------------------------------------------------------------
# Type: string (Minimum 32 random characters in production)
# IMPORTANT: Generate with `openssl rand -hex 32` before deploying!
SECRET_KEY=insecure-dev-secret-key-must-be-changed-in-production-min-32-chars

# Type: string (JWT signing algorithm)
# Default: HS256
ALGORITHM=HS256

# Type: integer (access token TTL in minutes)
# Default: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Type: integer (refresh token TTL in days)
# Default: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. API Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
# Type: integer (requests per client IP per minute for standard endpoints)
# Default: 60
RATE_LIMIT_PER_MINUTE=60

# Type: integer (simulations allowed per student per hour)
# Default: 5
SIMULATION_RATE_LIMIT_PER_HOUR=5

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Type: string (Google AI Studio API Key)
# Required in live production to run AI simulations, skill tests, and mentor chat
GEMINI_API_KEY=

# Type: string (Target Gemini model identifier)
# Default: gemini-2.5-flash (or gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Type: string (Internal prompt version identifier for audit tracking)
# Default: v1.0.0
PROMPT_VERSION=v1.0.0

# ------------------------------------------------------------------------------
# 6. Production Gunicorn ASGI Settings (Optional / Server Deployments)
# ------------------------------------------------------------------------------
# Type: integer (Number of worker processes; defaults to 2 * CPU cores + 1)
WEB_CONCURRENCY=4

# Type: integer (Worker timeout in seconds; must accommodate AI streaming)
# Default: 120
GUNICORN_TIMEOUT=120

# Type: string ("debug" | "info" | "warning" | "error" | "critical")
# Default: info
LOG_LEVEL=info
